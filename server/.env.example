# Database Configuration
MONGO_URI=mongodb://localhost:27017/stock-tracker

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here

# Alpha Vantage API (for real stock data)
STOCK_API_KEY=your_alpha_vantage_api_key_here

# OpenAI API (for advanced chatbot)
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API (for AI-powered chatbot)
GEMINI_API_KEY=your_google_gemini_api_key_here

# Server Configuration
PORT=5000
NODE_ENV=development
